{
  "name": "team-speak-to-discord",
  "version": "0.1.0",
  "description": "A high-performance bridge connecting TeamSpeak 3/5 with Discord for bidirectional audio and chat synchronization",
  "main": "dist/bot/index.js",
  "types": "dist/bot/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/bot/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bot/index.js",
    "lint": "biome check --write src/ && eslint src/ --ext .ts",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "docker:build": "docker build -t team-speak-to-discord .",
    "docker:run": "docker compose up -d",
    "docker:logs": "docker compose logs -f bridge",
    "install:wizard": "tsx scripts/install.ts",
    "migrate": "tsx scripts/migrate.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "prepare": "husky install"
  },
  "keywords": [
    "teamspeak",
    "discord",
    "bridge",
    "bot",
    "audio",
    "voice",
    "chat",
    "synchronization",
    "typescript"
  ],
  "author": "3bdelrahmanashraf <https://github.com/3bdelrahmanashraf>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/3bdelrahmanashraf/Team-Speak-To-Discord.git"
  },
  "bugs": {
    "url": "https://github.com/3bdelrahmanashraf/Team-Speak-To-Discord/issues"
  },
  "homepage": "https://github.com/3bdelrahmanashraf/Team-Speak-To-Discord#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.0",
  "dependencies": {
    "@discordjs/opus": "^0.9.0",
    "@discordjs/voice": "^0.17.0",
    "@prisma/client": "^5.14.0",
    "discord.js": "^14.15.0",
    "node-teamspeak": "^2.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.23.0",
    "@silero/vad": "^1.0.0",
    "rnnoise": "^1.0.0",
    "ioredis": "^5.4.0",
    "bullmq": "^5.8.0",
    "fastify": "^4.27.0",
    "@fastify/websocket": "^10.0.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/jwt": "^8.0.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0",
    "tsx": "^4.11.0",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0",
    "biome": "^1.7.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-unused-imports": "^3.1.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prisma": "^5.14.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "biome check --write",
      "eslint --fix"
    ]
  }
}