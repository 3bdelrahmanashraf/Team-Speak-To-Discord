# =============================================================================
# Team Speak To Discord Bridge - Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# All values can also be set via environment variables
# =============================================================================

# -----------------------------------------------------------------------------
# Discord Configuration
# -----------------------------------------------------------------------------
# Get these from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_guild_id_here

# Optional: Override default intents (comma-separated)
# DISCORD_INTENTS=Guilds,GuildMembers,GuildVoiceStates,GuildMessages,MessageContent,GuildMessageReactions,DirectMessages,DirectMessageReactions

# -----------------------------------------------------------------------------
# TeamSpeak Configuration
# -----------------------------------------------------------------------------
# TeamSpeak 3 ServerQuery (TCP)
TS_HOST=your_teamspeak_host
TS_QUERY_PORT=10011
TS_USERNAME=serveradmin
TS_PASSWORD=your_query_password
TS_SERVER_ID=1

# TeamSpeak 5 WebSocket (optional, for TS5 support)
# TS_USE_TS5=false
# TS_SSH_PORT=10022
# TS5_WEBSOCKET_PORT=9987

# Bot nickname on TeamSpeak
TS_NICKNAME=Discord Bridge

# Reconnection settings
TS_RECONNECT_INTERVAL=5000
TS_MAX_RECONNECT_ATTEMPTS=10

# -----------------------------------------------------------------------------
# Audio Configuration
# -----------------------------------------------------------------------------
# Quality presets: low (24kbps), medium (48kbps), high (64kbps), ultra (128kbps)
AUDIO_QUALITY=high
AUDIO_BITRATE=64000
AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=1
AUDIO_FRAME_SIZE=960

# Voice Activity Detection
AUDIO_VAD_ENABLED=true
AUDIO_VAD_THRESHOLD=0.5

# Noise Suppression (RNNoise)
AUDIO_NOISE_SUPPRESSION_ENABLED=true
AUDIO_NOISE_SUPPRESSION_LEVEL=2

# Jitter Buffer (ms)
AUDIO_JITTER_BUFFER_MS=100

# Adaptive bitrate based on network conditions
AUDIO_ADAPTIVE_BITRATE=true

# Opus application type: voip, audio, restricted-lowdelay
AUDIO_OPUS_APPLICATION=voip

# -----------------------------------------------------------------------------
# Chat Configuration
# -----------------------------------------------------------------------------
CHAT_SYNC_ENABLED=true
CHAT_SYNC_INTERVAL=1000
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_EMBED_LINKS=true
CHAT_EMBED_IMAGES=true
CHAT_SHOW_TIMESTAMPS=true
CHAT_SHOW_USER_BADGES=true
CHAT_THREAD_MAPPING=true
CHAT_MENTION_MAPPING=true
CHAT_COMMAND_PREFIX=!
CHAT_IGNORED_CHANNELS=

# -----------------------------------------------------------------------------
# User & Permission Configuration
# -----------------------------------------------------------------------------
USER_LINK_ENABLED=true
USER_NICKNAME_SYNC=true
USER_AVATAR_SYNC=false
USER_ROLE_MAPPING={"Server Admin":"Admin","Moderator":"Mod"}
USER_PERMISSION_SYNC=true
USER_PRESENCE_SYNC=true
USER_BAN_SYNC=true
USER_KICK_SYNC=true

# -----------------------------------------------------------------------------
# Bridge Core Configuration
# -----------------------------------------------------------------------------
BRIDGE_LOG_LEVEL=info
BRIDGE_SYNC_INTERVAL=5000
BRIDGE_HEALTH_CHECK_INTERVAL=30000
BRIDGE_MAX_CONCURRENT_USERS=100

# Rate limiting
BRIDGE_RATE_LIMIT_WINDOW_MS=60000
BRIDGE_RATE_LIMIT_MAX_REQUESTS=100

# Encryption for sensitive config
BRIDGE_ENCRYPTION_ENABLED=true
BRIDGE_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://bridge:password@localhost:5432/teamspeak_discord_bridge
DATABASE_POOL_SIZE=10
DATABASE_SSL=false

# -----------------------------------------------------------------------------
# Redis Configuration (for clustering & caching)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=tsdc:
REDIS_CONNECTION_TIMEOUT=10000

# -----------------------------------------------------------------------------
# Web Dashboard Configuration
# -----------------------------------------------------------------------------
WEB_DASHBOARD_ENABLED=true
WEB_DASHBOARD_PORT=3000
WEB_DASHBOARD_HOST=0.0.0.0
WEB_DASHBOARD_CORS_ORIGINS=http://localhost:3000
WEB_DASHBOARD_SESSION_SECRET=

# Discord OAuth for dashboard (optional)
# WEB_DASHBOARD_DISCORD_CLIENT_ID=
# WEB_DASHBOARD_DISCORD_CLIENT_SECRET=
# WEB_DASHBOARD_DISCORD_CALLBACK_URL=

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
NODE_ENV=development